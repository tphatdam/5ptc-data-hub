# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
# Option A: DATABASE_URL (recommended in production)
# SSL: add ?sslmode=require to the URL or set DATABASE_SSL=true
# For Railway and similar cloud hosts (*.rlwy.net), use the plain URL; SSL is enabled automatically.
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/vnstock_hub
# Option B: discrete DB_* values (recommended in local development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=your_password_here
# DB_NAME=vnstock_hub

# HTTP Client Configuration (Optional)
HTTP_TIMEOUT_MS=30000
HTTP_RETRIES=3
HTTP_RETRY_BASE_MS=1000

# Ingestion Schedule Configuration (Optional)
# Intraday job cron expression (default: every 15 minutes)
INTRADAY_CRON=*/15 * * * *
# Daily EOD job cron expression (default: 18:05 daily)
DAILY_EOD_CRON=5 18 * * *
# Timezone for scheduled jobs (default: Asia/Ho_Chi_Minh)
SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh

# Unified ingestion cutover flags
# UNIFIED_MODE=legacy|datahub
UNIFIED_MODE=datahub
UNIFIED_BACKFILL_ENABLED=false
UNIFIED_BACKFILL_BATCH_SIZE=500
# UNIFIED_NEWS_SOURCE_MODE=daily-company|realtime
UNIFIED_NEWS_SOURCE_MODE=daily-company
UNIFIED_LEGACY_COMPAT_VIEWS_ENABLED=false

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=your_bucket_name

# Redis - use REDIS_URL only (e.g. redis://localhost:6379 for local)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Sendinblue/Brevo
SENDINBLUE_API_KEY=your_sendinblue_key_here

# Seed (Exchanges, Symbols, Market Indices)
RUN_SEED=false
SEED_SOURCE=sstock
SEED_FALLBACK=true
SSTOCK_BASE_URL=https://api-feature.sstock.vn
# SSTOCK_COOKIE=your_cookie_header_value
SEED_HTTP_TIMEOUT_MS=20000
SEED_HTTP_RETRIES=4
SEED_BATCH_SIZE=300
SEED_ADVISORY_LOCK_KEY=987654321
BOOTSTRAP_SEED_ADVISORY_LOCK_KEY=987654322
# Safety switch for `npm run db:clear`
# DB_CLEAR_CONFIRM=YES
