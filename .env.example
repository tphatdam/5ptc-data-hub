# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
# Option 1: Use DATABASE_URL (recommended for production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vnstock_hub

# Option 2: Use discrete database variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password_here
DB_NAME=vnstock_hub

# HTTP Client Configuration (Optional)
HTTP_TIMEOUT_MS=30000
HTTP_RETRIES=3
HTTP_RETRY_BASE_MS=1000

# Ingestion Schedule Configuration (Optional)
# Intraday job cron expression (default: every 15 minutes)
INTRADAY_CRON=*/15 * * * *
# Daily EOD job cron expression (default: 18:05 daily)
DAILY_EOD_CRON=5 18 * * *
# Timezone for scheduled jobs (default: Asia/Ho_Chi_Minh)
SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=your_bucket_name

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Sendinblue/Brevo
SENDINBLUE_API_KEY=your_sendinblue_key_here

# Seed (Exchanges, Symbols, Market Indices)
RUN_SEED=false
SEED_SOURCE=sstock
SEED_FALLBACK=true
SSTOCK_BASE_URL=https://api-feature.sstock.vn
# SSTOCK_COOKIE=your_cookie_header_value
SEED_HTTP_TIMEOUT_MS=20000
SEED_HTTP_RETRIES=4
SEED_BATCH_SIZE=300
SEED_ADVISORY_LOCK_KEY=987654321
